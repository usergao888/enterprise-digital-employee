# ---- 运行后端 --------------------------------------------------------
# fake         = 离线确定性后端，不需要 Key（默认，用于 demo / 测试）
# openai_compat= 任何 OpenAI 兼容端点（DeepSeek / DashScope / vLLM / Ollama）
DE_LLM_BACKEND=fake

# DeepSeek
# DE_LLM_BASE_URL=https://api.deepseek.com/v1
# DE_LLM_API_KEY=sk-xxxx
# DE_LLM_MODEL=deepseek-reasoner
# DE_SMALL_MODEL=deepseek-chat

# 阿里云 DashScope（Qwen）兼容模式
# DE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DE_LLM_API_KEY=sk-xxxx
# DE_LLM_MODEL=qwen-max
# DE_SMALL_MODEL=qwen-plus

# 本地 Ollama
# DE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DE_LLM_API_KEY=ollama
# DE_LLM_MODEL=qwen2.5:14b
# DE_SMALL_MODEL=qwen2.5:7b

# ---- Embedding 后端 --------------------------------------------------
# hashing = 无需模型、确定性、可离线测试；对外演示/上线请换成 openai_compat
DE_EMBED_BACKEND=hashing
# DE_EMBED_BACKEND=openai_compat
# DE_EMBED_MODEL=text-embedding-v3
# DE_EMBED_DIM=1024

# ---- 检索参数 --------------------------------------------------------
DE_CHUNK_SIZE=520
DE_CHUNK_OVERLAP=90
DE_TOP_K_DENSE=12
DE_TOP_K_SPARSE=12
DE_TOP_K_FINAL=5
DE_ENABLE_RERANK=true

# ---- 编排参数 --------------------------------------------------------
DE_MAX_ITERATIONS=6
DE_MAX_REVISIONS=1
DE_RECURSION_LIMIT=40
DE_ENABLE_REVIEWER=true
DE_ROUTER_ENABLED=true

# ---- 服务 ------------------------------------------------------------
DE_HOST=127.0.0.1
DE_PORT=8710
